{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eco-security-patent-navigation",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eco-security-patent-navigation-db",
      "database_id": "723aecbf-4e03-4026-9286-ecc60ec72d51"
    }
  ],
  "observability": {
    "enabled": true
  }
}
